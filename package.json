{
  "name": "mathe-reise",
  "private": true,
  "version": "0.32.8",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "catalog:validate": "node scripts/catalog.mjs validate",
    "catalog:build": "node scripts/catalog.mjs build",
    "catalog:check": "node scripts/catalog.mjs check",
    "curriculum:build": "node scripts/curriculum-matrix.mjs build",
    "curriculum:check": "node scripts/curriculum-matrix.mjs check",
    "prebuild": "npm run catalog:check",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run review:check-production",
    "review:check-production": "node scripts/review-build-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:container": "E2E_BASE_URL=${E2E_BASE_URL:-http://127.0.0.1:8080} playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "~6.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
