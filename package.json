{
  "name": "mathe-reise",
  "private": true,
  "version": "0.32.14",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "catalog:validate": "node scripts/catalog.mjs validate",
    "catalog:build": "node scripts/catalog.mjs build",
    "catalog:check": "node scripts/catalog.mjs check",
    "curriculum:build": "node scripts/curriculum-matrix.mjs build",
    "curriculum:check": "node scripts/curriculum-matrix.mjs check",
    "prebuild": "npm run catalog:check",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run review:check-production",
    "review:check-production": "node scripts/review-build-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:container": "E2E_BASE_URL=${E2E_BASE_URL:-http://127.0.0.1:8080} playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
